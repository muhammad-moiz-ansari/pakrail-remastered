# Server only. Copy placeholders into ignored .env.local and fill them locally.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=pakrail_remastered
# mongodb is the default. demo is an explicit, labelled fixture provider.
STATION_DATA_PROVIDER=mongodb

# Accounts: use the exact origin used in your browser; generate a random 32+ character secret.
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=<generate-a-random-secret-of-at-least-32-characters>
# local is development-only; messages go to ignored .local/auth-mail, never public endpoints.
AUTH_MAIL_MODE=local
