{
  "name": "designify-rail",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsx --test tests/*.test.ts",
    "format:check": "prettier --check src tests scripts package.json tsconfig.json eslint.config.mjs",
    "db:check": "tsx scripts/catalogue.ts check",
    "db:indexes": "tsx scripts/catalogue.ts indexes",
    "catalogue:import": "tsx scripts/catalogue.ts import",
    "careers:import": "tsx scripts/careers.ts",
    "coaches:seed": "tsx scripts/coaches.ts",
    "auth:mail": "tsx scripts/auth-mail.ts",
    "accounts:check": "tsx scripts/check-accounts.ts --run",
    "predev": "node scripts/prepare-map.mjs",
    "prebuild": "node scripts/prepare-map.mjs"
  },
  "dependencies": {
    "@better-auth/mongo-adapter": "1.7.15",
    "@next/env": "^16.4.3",
    "better-auth": "1.7.15",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.3",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.16.0",
    "mongodb": "^7.8.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  }
}
